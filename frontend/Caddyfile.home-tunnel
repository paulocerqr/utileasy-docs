:80 {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	request_body /api/documents {
		max_size 12MB
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			# O Caddy externo substitui este cabeçalho pelo IP validado do cliente.
			header_up X-Utileasy-Client-IP {http.request.header.X-Utileasy-Client-IP}
			header_up -Cf-Connecting-Ip
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
